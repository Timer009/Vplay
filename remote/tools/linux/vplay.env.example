# VPLAY ARM64 Linux runtime env template (B19)
# Copy to /srv/vplay-lab/vplay.env and chmod 600.
# Never put the real model key here; it belongs to vplay-proxy.

VPLAY_HOME=/srv/vplay-lab/home
OPENGAME_WORKSPACE=/srv/vplay-lab/workspace
REMOTE_HOST=127.0.0.1
REMOTE_PORT=18787
PREVIEW_PORT=18788
REMOTE_AUTORUN=0

# Generated locally; not the model key.
PREVIEW_ACCESS_KEY=replace-with-32-plus-random-chars
EVIDENCE_HMAC_KEY=replace-with-32-plus-random-chars

# Single-task / low-memory Pi 5 defaults.
VPLAY_MAX_SNAPSHOTS=20
VPLAY_UMASK=027
REMOTE_TASK_TIMEOUT_MS=600000
REMOTE_RATE_LIMIT=1
REMOTE_SSE_LIMIT=4
VPLAY_LEASE_MAX_AGE_MS=15000
NODE_OPTIONS=--max-old-space-size=2048

# Browser: system ARM64 Chromium. Only allowlisted low-memory flags.
VPLAY_BROWSER_EXECUTABLE=/usr/bin/chromium
VPLAY_BROWSER_HEADLESS=true
VPLAY_BROWSER_ARGS=--disable-dev-shm-usage --disable-gpu --renderer-process-limit=2 --js-flags=--max-old-space-size=768

# Model credential proxy (C18): Vplay only sees a dummy key + loopback base URL.
OPENAI_BASE_URL=http://127.0.0.1:18900/v1
OPENAI_API_KEY=vplay-proxy-placeholder
# VPLAY_MODEL_PROXY_URL=http://127.0.0.1:18900/v1
# VPLAY_MODEL_PROXY_TOKEN=replace-with-proxy-scoped-token

# Evidence: staging is writable by vplay; sealed/ is owned by vplay-evidence.
VPLAY_EVIDENCE_STAGING=/srv/vplay-lab/evidence-staging
VPLAY_EVIDENCE_SEALED=/srv/vplay-lab/evidence
